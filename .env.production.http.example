# Private office-network HTTP deployment. Keep .env mode 600; never commit secrets.
# Set the server office-network IPv4 address (for this installation: 192.168.50.222).
HTTP_BIND_IP=
POSTGRES_DB=meeting_rooms
# Existing volumes: preserve their current bootstrap administrator username/password.
POSTGRES_USER=meeting_rooms
POSTGRES_PASSWORD=
# A distinct application role is created with NOSUPERUSER/NOCREATEDB/NOCREATEROLE.
POSTGRES_APP_USER=meeting_rooms_app
POSTGRES_APP_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=mbs.wdn.com.np
DJANGO_PUBLIC_BASE_URL=http://mbs.wdn.com.np
DJANGO_PRODUCTION=true
DJANGO_HTTPS=false
EMPLOYEE_EMAIL_DOMAINS=wdn.com.np,transgate.com.np
# Disabled is intentional until IT configures the approved company relay.
DJANGO_EMAIL_BACKEND=disabled
DJANGO_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Keep the proxy address outside the dynamic range and within the subnet.
# Change these together if this subnet conflicts with an existing Docker network.
PROXY_NETWORK_SUBNET=172.29.16.0/28
PROXY_NETWORK_DYNAMIC_RANGE=172.29.16.0/29
PROXY_IP=172.29.16.14
AUTH_TRUSTED_PROXY_CIDRS=172.29.16.14/32
