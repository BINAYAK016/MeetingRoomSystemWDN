log_format safe_request '$time_iso8601 method=$request_method status=$status '
                        'bytes=$body_bytes_sent duration=$request_time '
                        'upstream_status=$upstream_status request_id=$request_id';

upstream booking_application {
    zone booking_application 64k;
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 5s;
    server web:8000 resolve;
}

server {
    listen 443 ssl;
    server_name ${APP_HOSTNAME};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 6m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    access_log /var/log/nginx/access.log safe_request;
    # Request-bearing upstream error lines can contain tokens or personal query values.
    # Every response still has safe status/timing/upstream/request-id diagnostics above.
    error_log /var/log/nginx/error.log crit;
    location ~ ^/(sign-in/link|check-in/link|staff/set-password)/ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://booking_application;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }
    location / {
        proxy_pass http://booking_application;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }
}
