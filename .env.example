# Copy to .env and replace both secret values before using Docker Compose.
POSTGRES_DB=meeting_rooms
POSTGRES_USER=meeting_rooms
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=false
DJANGO_PUBLIC_BASE_URL=http://127.0.0.1:8000
EMPLOYEE_EMAIL_DOMAINS=wdn.com.np,transgate.com.np
# Local mail is saved inside the web container. Switch to smtp when IT supplies its relay.
DJANGO_EMAIL_BACKEND=file
DJANGO_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
AUTH_TRUSTED_PROXY_CIDRS=
